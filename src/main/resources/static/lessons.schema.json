{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paaduta Teeyaga lessons",
  "type": "object",
  "required": [
    "stages"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "about",
          "chapters"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "Stage name shown as a heading."
          },
          "about": {
            "type": "string",
            "description": "One sentence on what this stage adds."
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "title",
                "hint",
                "secondsPerBeat",
                "lessons"
              ],
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string"
                },
                "hint": {
                  "type": "string",
                  "description": "One tip shown above the lessons."
                },
                "secondsPerBeat": {
                  "type": "number",
                  "minimum": 0.3,
                  "maximum": 3,
                  "description": "1 is 60 beats a minute; smaller is faster."
                },
                "beatsPerLine": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 16,
                  "description": "Beats in one tala cycle. Defaults to 8 (Adi tala)."
                },
                "lessons": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {
                        "type": "string",
                        "description": "Optional. Without it the swaras are the name."
                      },
                      "theory": {
                        "type": "string",
                        "maxLength": 320,
                        "description": "A short note, three or four lines at most, shown above the lesson."
                      },
                      "swaras": {
                        "type": "string",
                        "pattern": "^\\s*[SRGMPDN]['.]?(\\s+([SRGMPDN]['.]?|,|\\|))*\\s*$",
                        "description": "S R G M P D N; ' for upper octave, . for lower octave, a comma holds one more beat, | separates lines."
                      },
                      "listen": {
                        "type": "object",
                        "description": "A listening game instead of singing: two notes play and the learner says whether the second went up or down.",
                        "required": [
                          "intervals"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "intervals": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 11
                            },
                            "description": "Jump sizes in semitones, both notes within Sa to upper Sa: 7 is Sa to Pa, 4 Sa to Ga, 2 Sa to Ri, 1 Ga to Ma."
                          },
                          "same": {
                            "type": "boolean",
                            "description": "Also ask 'same' rounds where the note does not move."
                          },
                          "rounds": {
                            "type": "integer",
                            "minimum": 3,
                            "maximum": 20,
                            "description": "Rounds per try. Defaults to 8."
                          },
                          "demo": {
                            "type": "boolean",
                            "description": "A demonstration: each note is shown as it plays and nothing is asked."
                          }
                        }
                      },
                      "beatsPerLine": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 16,
                        "description": "Overrides the chapter's beats per line, for a lesson in its own taalam."
                      }
                    },
                    "anyOf": [
                      {
                        "required": [
                          "swaras"
                        ]
                      },
                      {
                        "required": [
                          "title",
                          "listen"
                        ]
                      }
                    ]
                  }
                },
                "ragam": {
                  "type": "string",
                  "enum": [
                    "mayamalavagowla",
                    "sankarabharanam"
                  ],
                  "description": "Ragam for the swarams. Defaults to mayamalavagowla."
                }
              }
            }
          },
          "ragam": {
            "type": "string",
            "enum": [
              "mayamalavagowla",
              "sankarabharanam"
            ],
            "description": "Ragam for the swarams. Defaults to mayamalavagowla."
          }
        }
      }
    }
  }
}
